    "operacion = int(input(f\"Bienvenido a 'LA BIBLIOTECA', ¿Qué operación desea realizar? 1: visualizar todos los libros de la biblioteca, 2: buscar libro, 3: añadir libro, 4: eliminar libro por título, 5: alquilar libro, 6: devolver\"))\n",
    "\n",
    "match operacion:\n",
    "\n",
    "    case 1:\n",
    "        for libro in libros:\n",
    "            print(f\"Título: {libro['Titulo']}\")\n",
    "\n",
    "    case 2:\n",
    "        buscar_libro = input(f\"Introduzca el título del libro que desea buscar:\")\n",
    "        encontrado = False\n",
    "        for libro in libros:\n",
    "            if buscar_libro.lower() == libro[\"Titulo\"].lower():\n",
    "                encontrado = True\n",
    "                print(f\"Título: {libro['Titulo']}\")\n",
    "                print(f\"Autor: {libro['Autor']}\")\n",
    "                print(f\"Alquilado: {libro['Alquilado']}\")\n",
    "                break\n",
    "        if encontrado == False:\n",
    "            print(f\"El libro {buscar_libro} no pertenece a la biblioteca\")\n",
    "\n",
    "    case 3:\n",
    "        nuevo_titulo = input(f\"Introduzca el 'Título' del libro que desea añadir a la biblioteca:\")\n",
    "        nuevo_autor = input(f\"Introduzca el 'Autor':\")\n",
    "        nuevo_libro = {\"Titulo\": nuevo_titulo, \"Autor\": nuevo_autor, \"Alquilado\":  False}\n",
    "        libros.append(nuevo_libro) \n",
    "        print(f\"El libro {nuevo_titulo} ha sido añadido a la biblioteca\")\n",
    "\n",
    "    case 4:\n",
    "        eliminar_libro = input(f\"Introduzca el 'Título' del libro que desea eliminar de la biblioteca:\")\n",
    "        for libro in libros:\n",
    "            if libro[\"Titulo\"].lower() == eliminar_libro.lower():\n",
    "                libros.remove(libro)\n",
    "                print(f\"El libro {eliminar_libro} ha sido eliminado de la biblioteca\")\n",
    "\n",
    "    case 5:\n",
    "        alquilar_libro = input(f\"Introduzca el 'Título' del libro que desea alquilar:\")\n",
    "        encontrado = False      #Primero voy a comprobar que el pertenece a la biblioteca\n",
    "        for libro in libros:\n",
    "            if alquilar_libro.lower() == libro[\"Titulo\"].lower():\n",
    "                encontrado = True    \n",
    "                if libro[\"Alquilado\"] == False:         #Segundo compruebo que no está alquilado\n",
    "                    libro[\"Alquilado\"] = True\n",
    "                    print(f\"Se acaba de alquilar {alquilar_libro}\")\n",
    "                else:\n",
    "                    print(f\"El libro {alquilar_libro} se encuentra alquilado\")\n",
    "                break\n",
    "        if encontrado == False:\n",
    "            print(f\"El libro {alquilar_libro} no pertenece a la biblioteca\")\n",
    "\n",
    "    case 6:\n",
    "        devolver_libro = input(f\"Introduzca el 'Título' del libro que desea devolver:\")\n",
    "        encontrado = False          #Similar al apartado anterior\n",
    "        for libro in libros:\n",
    "            if devolver_libro.lower() == libro[\"Titulo\"].lower():\n",
    "                encontrado = True   \n",
    "                if libro[\"Alquilado\"] == True:\n",
    "                    libro[\"Alquilado\"] = False\n",
    "                    print(f\"Se acaba de devolver {devolver_libro}\")\n",
    "                    break\n",
    "        if encontrado == False:\n",
    "            print(f\"Por favor revise si el título del libro '{devolver_libro}' es correcto\")\n",
    "\n",
    "    case _:\n",
    "        print(f\"La opción {operacion} no existe. Por favor, elija una opción correcta\")"
